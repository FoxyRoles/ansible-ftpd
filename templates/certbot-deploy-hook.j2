#!/bin/bash

set -euo pipefail

RENEWED_LINEAGE=${RENEWED_LINEAGE:-/etc/letsencrypt/live/{{ ansible_fqdn }}}
CERTIFICATE=$(basename "$RENEWED_LINEAGE")
PURE_CERT={{ pure_certificate_path | quote }}

if [ "$CERTIFICATE" != "{{ ansible_fqdn }}" ]; then
    exit 0
fi

umask 077
cat "$RENEWED_LINEAGE/privkey.pem" "$RENEWED_LINEAGE/fullchain.pem" > "$PURE_CERT"
chmod 600 "$PURE_CERT"

if [ -f "/usr/sbin/pure-ftpd" ]; then
    systemctl restart pure-ftpd
fi
if [ -f "/usr/sbin/pure-ftpd-mysql" ]; then
    systemctl restart pure-ftpd-mysql
fi
